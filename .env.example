# Copy this file to .env for local development.
# No need for DATABASE_URL to be set if developing from within a devcontainer

# Any long random string. Generate one with:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-long-random-string
DATABASE_URL=sqlite:///dev.db
SCHEMA=flask_schema

# Minutes since a user's last request that still count as "online" for the
# presence dots. Seeded demo accounts never make requests, so raise this (e.g.
# 10080 for a week) if you want the online rail populated on a demo database.
PRESENCE_WINDOW_MINUTES=5

# ── Uploads: S3-compatible bucket (Cloudflare R2, AWS S3 ...) ──
# Leave blank locally to save uploads to app/uploads/ instead.
S3_BUCKET=
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Public address of the bucket, e.g. https://media.yourdomain.com
S3_PUBLIC_URL=

# ── Safety / launch ──
# Comma-separated emails that can review reports at /admin/reports
ADMIN_EMAILS=
# Shown on the Privacy, Terms and Support pages
SUPPORT_EMAIL=
# Extra words to block in posts/comments/messages (comma-separated)
BLOCKED_WORDS=
# Youngest age allowed to sign up
MINIMUM_AGE=13
# The Bolt top-up and Shop checkout are demos that never charge anyone.
# On by default in development, off in production. Force with true/false.
DEMO_PAYMENTS=
# Seed fake demo users/posts into a real database on first boot (true/false)
SEED_DEMO_DATA=
